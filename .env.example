# 复制为 .env 后按需修改: cp .env.example .env
# PostgreSQL：直接使用本机已有的 pgdb 容器（5432，postgres/password）
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/appdb
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
DB_MAX_CONNECTIONS=10
# 跨域白名单（逗号分隔，例如 http://localhost:5173；留空 = 默认拒绝跨域，仅同源）
CORS_ALLOWED_ORIGINS=
# 平台管理员引导（可选；投诉审核需要 admin 账号。两者必须同时提供，留空则跳过引导）
# - 手机号不存在时创建 admin 账号；已存在同手机号 admin 则保持原密码不动；
# - 该手机号已被 seeker/recruiter 占用时，服务启动会失败（拒绝把既有账号提权）
ADMIN_PHONE=
ADMIN_PASSWORD=
# 管理员显示名（可选，默认「平台管理员」）
ADMIN_NAME=
# 日志级别: tracing 过滤语法, 例如 debug,tracing_actix_web=info,sqlx=warn
RUST_LOG=info,tracing_actix_web=info,sqlx=warn
